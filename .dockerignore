# Build context is the repo root (see Dockerfile) — only server/ and brain/'s
# actual source are needed; everything else here just bloats the build context.

.git/
.zed/
notes/
firmware/
hw-test/
test/
sw-test/
*.md

# brain/ — keep app/, static/, entrypoint.sh, requirements.txt; drop the rest
brain/tests/
brain/data/
brain/cosyvoice/
brain/.env
brain/.env.*
brain/*.postman_collection.json
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# server/ — drop anything not needed for the Go build
server/.env
