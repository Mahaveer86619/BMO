[
  {
    "label": "Pico: Upload firmware",
    "command": "make",
    "args": ["-C", "firmware", "upload"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Pico: Run current file",
    "command": "make",
    "args": ["-C", "firmware", "run", "FILE=$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Pico: Monitor (REPL)",
    "command": "make",
    "args": ["-C", "firmware", "monitor"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Pico: List files on board",
    "command": "make",
    "args": ["-C", "firmware", "ls"],
    "use_new_terminal": false,
    "reveal": "always"
  }
]
