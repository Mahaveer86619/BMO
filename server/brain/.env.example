# Copy this to .env and fill in your values.
# .env is the single source of truth — docker-compose reads it directly.

# ─── PROFILES ───────────────────────────────────────────────────────────────────
# Comma-separated list of optional service profiles to enable.
#   ollama    — run Ollama (LLM) as a container instead of natively on the host
#   cosyvoice — run CosyVoice TTS as a container
# Example: COMPOSE_PROFILES=cosyvoice
COMPOSE_PROFILES=


# ─── OLLAMA (LLM) ───────────────────────────────────────────────────────────────
# Local dev: Ollama installed natively on Windows, app reaches it via Docker bridge
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Full Docker (requires COMPOSE_PROFILES=ollama):
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2:3b


# ─── STT ────────────────────────────────────────────────────────────────────────
STT_PROVIDER=local          # local | huggingface
WHISPER_MODEL=base          # tiny | base | small | medium (larger = more accurate, slower)

# Only needed when STT_PROVIDER=huggingface
# HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# HF_WHISPER_MODEL=openai/whisper-base


# ─── TTS ────────────────────────────────────────────────────────────────────────
TTS_PROVIDER=piper          # piper | kokoro | xtts | cosyvoice

# ── Kokoro-82M (CPU-friendly, ~330MB, no separate service needed) ─────────────
# KOKORO_VOICE=af_sky        # af_sky af_bella af_nicole am_adam am_michael
#                            # bf_emma bf_isabella bm_george bm_lewis
# KOKORO_LANG=a              # a = American English, b = British English
# KOKORO_SPEED=1.0

# ── CosyVoice (requires COMPOSE_PROFILES=cosyvoice) ──────────────────────────
# COSYVOICE_URL=http://cosyvoice:50000

# Which model to use (name used locally + HuggingFace repo ID):
# COSYVOICE_MODEL=CosyVoice2-0.5B
# COSYVOICE_HF_REPO=FunAudioLLM/CosyVoice2-0.5B
# Alternative (newer, better quality):
# COSYVOICE_MODEL=Fun-CosyVoice3-0.5B
# COSYVOICE_HF_REPO=FunAudioLLM/Fun-CosyVoice3-0.5B-2512

# Mode: sft (built-in speaker) | zero_shot (voice clone) | instruct
# COSYVOICE_MODE=sft

# SFT speaker — built-in voices in CosyVoice2-0.5B:
#   English : 英文女  英文男
#   Chinese : 中文女  中文男
# COSYVOICE_SPEAKER=英文女

# zero_shot: path to a 10-30s clean reference wav + its verbatim transcript
# (reference.wav is the same file used by XTTS — reuse it here)
# COSYVOICE_PROMPT_TEXT=The quick brown fox jumps over the lazy dog.

# instruct: style/emotion hint (only used in instruct mode)
# COSYVOICE_INSTRUCT_TEXT=Use a friendly, curious tone.

# Output sample rate of the model's vocoder (22050 for all CosyVoice variants)
# COSYVOICE_SAMPLE_RATE=22050


# ─── DATABASE ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bmo:bmo_pass@db:5432/bmo_db


# ─── TOOLS ──────────────────────────────────────────────────────────────────────
DEFAULT_WEATHER_LOCATION=London


# ─── WAKE WORD ──────────────────────────────────────────────────────────────────
# Leave empty to disable. When set, audio without this word is silently dropped.
WAKE_WORD=


# ─── MINIO (audio storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=bmo
MINIO_SECRET_KEY=bmo_secret
MINIO_BUCKET=bmo-audio
MINIO_SECURE=false


# ─── LOGGING ────────────────────────────────────────────────────────────────────
# dev     : full pipeline steps (STT/CMD/LLM/TTS payloads)
# verbose : everything at DEBUG including httpcore/httpx internals
# alerts  : standard operational logs (default)
# ignore  : warnings and errors only
LOG_LEVEL=alerts
